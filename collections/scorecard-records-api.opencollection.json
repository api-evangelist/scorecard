{
  "opencollection": "1.0.0",
  "info": {
    "name": "Scorecard Metrics Records API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Records",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete Record",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api2.scorecard.io/api/v2/records/:recordId",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path",
                "description": "The ID of the Record to delete."
              }
            ]
          },
          "docs": "Delete a specific Record by ID."
        },
        {
          "info": {
            "name": "List Annotations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.scorecard.io/api/v2/records/:recordId/annotations",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path",
                "description": "The ID of the Record to list annotations for."
              }
            ]
          },
          "docs": "List all annotations (ratings and comments) for a specific Record."
        },
        {
          "info": {
            "name": "List Record Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.scorecard.io/api/v2/records/:recordId/tags",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path",
                "description": "The ID of the Record to list tags for."
              }
            ]
          },
          "docs": "List all tags applied to a specific Record."
        },
        {
          "info": {
            "name": "Create Record Tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api2.scorecard.io/api/v2/records/:recordId/tags",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path",
                "description": "The ID of the Record to tag."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Apply a tag to a Record. Idempotent: re-applying an existing tag returns the existing tag."
        },
        {
          "info": {
            "name": "Delete Record Tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api2.scorecard.io/api/v2/records/:recordId/tags/:text",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path",
                "description": "The ID of the Record to remove the tag from."
              },
              {
                "name": "text",
                "value": "",
                "type": "path",
                "description": "The tag text to remove."
              }
            ]
          },
          "docs": "Remove a tag from a Record by its text."
        },
        {
          "info": {
            "name": "Upsert Score",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api2.scorecard.io/api/v2/records/:recordId/scores/:metricConfigId",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path",
                "description": "The ID of the Record to upsert the Score for."
              },
              {
                "name": "metricConfigId",
                "value": "",
                "type": "path",
                "description": "The ID of the MetricConfig."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update a Score for a given Record and MetricConfig. If a Score with the specified Record ID and MetricConfig ID already exists, it will be updated. Otherwise, a new Score will be created. The score provided should conform to the schema defined by the MetricConfig; otherwise, validation errors will be reported."
        }
      ]
    }
  ],
  "bundled": true
}