{
  "opencollection": "1.0.0",
  "info": {
    "name": "Scorecard Metrics Runs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.scorecard.io/api/v2/runs/:runId",
            "params": [
              {
                "name": "runId",
                "value": "",
                "type": "path",
                "description": "The ID of the Run to retrieve."
              }
            ]
          },
          "docs": "Retrieve a specific Run by ID."
        },
        {
          "info": {
            "name": "List Records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.scorecard.io/api/v2/runs/:runId/records",
            "params": [
              {
                "name": "runId",
                "value": "",
                "type": "path",
                "description": "The ID of the Run to list records for."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return (1-100). Use with `cursor` for pagination through large sets."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination. Pass the `nextCursor` from the previous response to get the next page of results."
              },
              {
                "name": "tags",
                "value": "",
                "type": "query",
                "description": "Filter to records carrying every listed tag (repeatable, AND semantics). E.g. `?tags=urgent&tags=regression`."
              }
            ]
          },
          "docs": "Retrieve a paginated list of Records for a Run, including all scores for each record."
        },
        {
          "info": {
            "name": "Create Record",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api2.scorecard.io/api/v2/runs/:runId/records",
            "params": [
              {
                "name": "runId",
                "value": "",
                "type": "path",
                "description": "The ID of the Run."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new Record in a Run."
        }
      ]
    }
  ],
  "bundled": true
}