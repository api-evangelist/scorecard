{
  "opencollection": "1.0.0",
  "info": {
    "name": "Scorecard Metrics Systems API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Systems",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get system",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.scorecard.io/api/v2/systems/:systemId",
            "params": [
              {
                "name": "systemId",
                "value": "",
                "type": "path",
                "description": "The ID of the system to retrieve."
              }
            ]
          },
          "docs": "Retrieve a specific system by ID."
        },
        {
          "info": {
            "name": "Update system",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api2.scorecard.io/api/v2/systems/:systemId",
            "params": [
              {
                "name": "systemId",
                "value": "",
                "type": "path",
                "description": "The ID of the system to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing system. Only the fields provided in the request body will be updated.\nIf a field is provided, the new content will replace the existing content.\nIf a field is not provided, the existing content will remain unchanged."
        },
        {
          "info": {
            "name": "Delete system",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api2.scorecard.io/api/v2/systems/:systemId",
            "params": [
              {
                "name": "systemId",
                "value": "",
                "type": "path",
                "description": "The ID of the system to delete."
              }
            ]
          },
          "docs": "Delete a system definition by ID. This will not delete associated system versions."
        },
        {
          "info": {
            "name": "Get system version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.scorecard.io/api/v2/systems/versions/:systemVersionId",
            "params": [
              {
                "name": "systemVersionId",
                "value": "",
                "type": "path",
                "description": "The ID of the system version to retrieve."
              }
            ]
          },
          "docs": "Retrieve a specific system version by ID."
        },
        {
          "info": {
            "name": "Upsert system version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api2.scorecard.io/api/v2/systems/:systemId/versions",
            "params": [
              {
                "name": "systemId",
                "value": "",
                "type": "path",
                "description": "The ID of the system to create the system version for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new system version if it does not already exist. Does **not** set the created version to be the system's production version.\n\nIf there is already a system version with the same config, its name will be updated."
        }
      ]
    }
  ],
  "bundled": true
}